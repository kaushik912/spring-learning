  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/showtimes/6/bookings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test("status is 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  Scenario ID: SCN-004
  Scenario: tries to book seats but the request leaves out the list of seats entirely.
  Expected: the server should reject this clearly as a bad request (400), telling the caller a seat list is required.
  Currently fails: the server does not validate this field and crashes instead, so today this comes back as a generic server error (500) rather than a clean 400. This test is written to assert the CORRECT behavior on purpose, so it will fail until that validation is added — this is intentional, to document and track the bug (fix tracked separately, not part of this test).
}
