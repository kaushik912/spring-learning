meta {
  name: 03 - Get Product By Id - Not Found
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/products/999999
  body: none
  auth: none
}

tests {
  test("status is 404 Not Found", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("error body identifies the missing product", function () {
    const body = res.getBody();
    expect(body.status).to.equal(404);
    expect(body.error).to.equal("Not Found");
    expect(body.message).to.include("999999");
  });
}
